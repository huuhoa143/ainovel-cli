{
  // provider, model và cường độ suy luận dùng làm mặc định.
  // ★ Giá trị của provider là TÊN KEY của một mục trong providers bên dưới (một "con trỏ"), không phải tên giao thức —
  //   đổi provider thì phải bảo đảm trong providers có mục cùng tên, nếu không khởi động sẽ báo "chưa cấu hình thông tin xác thực".
  //   Lúc chạy thì dùng /config để quản Provider/thư viện model, dùng /model để chuyển giữa các model đã lưu.
  "provider": "openrouter",
  "model": "google/gemini-2.5-flash",
  // Tùy chọn. Cường độ suy luận mặc định: off / low / medium / high / xhigh / max.
  // Bỏ trống hoặc chuỗi rỗng = không ghi đè, dùng mặc định của model/provider.
  "reasoning_effort": "medium",

  // Kho thông tin xác thực của Provider. key tự đặt, dùng làm đích mà trường provider ở trên trỏ tới.
  // Các provider đã biết (openai/anthropic/gemini/openrouter/deepseek/qwen/glm/grok/mimo/ollama/bedrock)
  // thì được bỏ type; proxy tự định nghĩa buộc phải khai type tường minh để chỉ rõ giao thức API.
  "providers": {
    "openrouter": {
      "api_key": "sk-or-v1-xxx",
      "base_url": "https://openrouter.ai/api/v1",
      // Tùy chọn. Khai các ứng viên cho panel /model và cửa sổ ngữ cảnh riêng của từng model; mảng chuỗi kiểu cũ vẫn tương thích.
      // json_schema là phép ghi đè tường minh cho đầu ra có cấu trúc nguyên bản: true=xác nhận có hỗ trợ, false=xác nhận không hỗ trợ,
      // bỏ trống=dùng năng lực của adapter. Với proxy tự dựng hoặc khi năng lực tùy thuộc model cụ thể thì nên điền rõ.
      "models": [
        { "name": "google/gemini-3.0-flash", "context_window": 200000 },
        { "name": "google/gemini-3.1-pro", "context_window": 1000000 }
      ],
      // Tùy chọn. Tham số phụ truyền xuyên cho mỗi request của provider này (tham số lấy mẫu như temperature/top_p/
      // min_p, hoặc key riêng của hãng như chat_template_kwargs để nvidia bật think), ghép nguyên từng chữ vào body request.
      // Chỉ có hiệu lực với các provider tương thích OpenAI (openrouter/deepseek/qwen/glm/grok/ollama…);
      // type:"openai" thì lọc theo danh sách trắng tham số chính thức. Giá trị thì người dùng tự chịu trách nhiệm.
      "extra_body": { "temperature": 0.8, "min_p": 0.05 },
      // Tùy chọn. Cấu hình cấp provider, truyền xuyên xuống tầng HTTP client (không phải body request), dùng cho
      // các proxy cần tự định nghĩa User-Agent / headers / anthropic_beta.
      "extra": {
        "user_agent": "my-client/1.0",
        "headers": { "X-Custom-Client": "my-client" }
      }
    },
    "anthropic": {
      "api_key": "sk-ant-xxx",
      "models": [{ "name": "claude-sonnet-4-6", "json_schema": true }]
    },
    "ollama": {
      // ollama / bedrock / proxy tự định nghĩa có khai type tường minh thì được bỏ api_key
      // base_url cần kèm /v1 (endpoint tương thích OpenAI của ollama nằm dưới /v1)
      "base_url": "http://localhost:11434/v1",
      "models": [{ "name": "qwen3:14b", "context_window": 32768 }],
      // Tùy chọn. Watchdog cho lúc stream rảnh (Go duration, mặc định "5m"): LocalAI/ollama v.v.
      // suy luận chậm ở máy cục bộ thì khối đầu có thể vượt 5 phút, nới theo từng provider, không ảnh hưởng kênh khác
      "stream_idle_timeout": "15m"
    },
    "claude-code-proxy": {
      // Proxy Anthropic tự định nghĩa. Nếu upstream hạn chế chỉ client Claude Code truy cập được,
      // dùng extra để truyền xuyên user_agent / anthropic_beta / headers.
      // base_url không cần kèm /v1.
      "type": "anthropic",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com",
      "models": [{ "name": "claude-sonnet-4-6", "context_window": 1000000 }],
      "extra": {
        "user_agent": "claude-code/2.1.183",
        "anthropic_beta": "claude-code-20250219",
        "headers": {
          "X-Stainless-Lang": "js",
          "X-Stainless-Package-Version": "0.94.0",
          "X-Stainless-Runtime": "node"
        }
      }
    },
    "codex-proxy": {
      // Proxy OpenAI/NewAPI tự định nghĩa. Nếu upstream hạn chế chỉ client Codex truy cập được,
      // dùng extra để ghi đè User-Agent, và truyền xuyên các header nhận dạng Codex.
      // base_url điền theo địa chỉ thật của proxy; giao thức OpenAI thường cần /v1.
      "type": "openai",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com/v1",
      "models": [
        { "name": "gpt-5.4", "context_window": 400000, "json_schema": true },
        { "name": "gpt-5.4-mini" },
        { "name": "MiniMax-M3", "context_window": 1000000 }
      ],
      // Tùy chọn. Endpoint của giao thức OpenAI: chat (mặc định /v1/chat/completions) /
      // responses (/v1/responses). Proxy kiểu Codex thường cần responses.
      "api": "responses",
      "extra": {
        // Tùy chọn. Khóa định tuyến cache prompt_cache_key mặc định chỉ gửi cho api.openai.com chính thức —
        // các endpoint tương thích của bên thứ ba không có hợp đồng thống nhất cho trường không rõ (Groq/Cerebras/Volcano
        // và các endpoint nghiêm khác sẽ trả 400, còn loại trung chuyển tái đóng gói thì bỏ im lặng). Khi đã xác nhận
        // proxy của bạn truyền body request nguyên trạng tới OpenAI thì bật mục này để có ái lực định tuyến cache (tăng tỉ lệ trúng).
        "prompt_cache_params": true,
        "user_agent": "codex-tui/0.142.3 (Mac OS 26.5.1; arm64) Apple_Terminal/470.2 (codex-tui; 0.142.3)",
        "headers": {
          "Originator": "codex-tui",
          "Session_id": "replace-with-random-session-id",
          "X-Codex-Turn-Metadata": "replace-with-random-turn-metadata"
        }
      }
    }
  },

  // Tùy chọn. Ghi đè model mặc định theo vai; vai không cấu hình thì dùng model ở trên.
  // reasoning_effort cũng ghi đè được theo vai; không cấu hình thì kế thừa reasoning_effort ở tầng đỉnh.
  // Các vai: architect / writer / editor. fallbacks được thử theo thứ tự khi model chính thất bại.
  // Chú ý: provider ở đây cũng là "con trỏ", buộc phải trỏ tới một key có thật trong providers.
  // "roles": {
  //   "writer": {
  //     "provider": "anthropic",
  //     "model": "claude-sonnet-4",
  //     "reasoning_effort": "high",
  //     "fallbacks": [{ "provider": "openrouter", "model": "google/gemini-3.0-pro" }]
  //   },
  //   "architect": { "provider": "openrouter", "model": "google/gemini-3.1-pro" }
  // },

  // Văn phong: default / suspense / fantasy / romance.
  "style": "default"

  // Cửa sổ ngữ cảnh toàn cục kiểu cũ, giữ lại làm phần lùi về cho mọi model. Ưu tiên thấp hơn models[].context_window,
  // cao hơn sổ đăng ký model và giá trị mặc định 200k. Chỉ ảnh hưởng ngưỡng nén, không đổi độ dài request thật của API.
  // "context_window": 300000

  // Tùy chọn. Ngân sách chi phí cho một cuốn sách (thư mục output), là cầu chì khi chạy không người trực. Phải book_usd > 0 mới bật.
  // Khi chi phí cộng dồn đạt warn_ratio thì cảnh báo mà không dừng máy; đạt 100% thì dừng máy êm sau khi
  // tác vụ tác tử con hiện tại kết thúc (hard_stop=true thì vượt vạch là dừng ngay). Sau khi dừng, nâng book_usd lên là chạy tiếp được.
  // Chú ý: model tự định nghĩa mà sổ đăng ký không tra được giá và provider cũng không tự báo cost thì ngân sách coi như vô hiệu.
  // "budget": {
  //   "book_usd": 50,
  //   "warn_ratio": 0.8,
  //   "hard_stop": false
  // },

  // Tùy chọn. Cảnh báo khi chạy không người trực, mặc định bật (Windows notification / macOS osascript / Linux notify-send).
  // Cấu hình command thì chuyển sang chạy lệnh tự định nghĩa (đẩy thông báo lên điện thoại thì đi đường này): các trường được
  // truyền vào qua biến môi trường NOTIFY_TITLE / NOTIFY_BODY / NOTIFY_KIND / NOTIFY_LEVEL, đồng thời JSON đầy đủ ghi vào stdin.
  // Unix shell dùng $NOTIFY_TITLE; Windows PowerShell dùng $env:NOTIFY_TITLE.
  // events là bộ lọc tùy chọn: run_end / budget / advance_gate / stop_guard /
  // plan_start / deadlock / worker_failure; bỏ trống thì bật hết.
  // "notify": {
  //   "enabled": true,
  //   // Tiêu đề/nội dung có dấu tiếng Việt và dấu cách, buộc phải truyền qua --data-urlencode, không được ghép vào đường dẫn URL hay HTTP header.
  //   // Bark (iOS):         "command": "curl -s --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"body=$NOTIFY_BODY\" https://api.day.app/<key>"
  //   // ntfy (iOS/Android): "command": "curl -s -G --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"message=$NOTIFY_BODY\" ntfy.sh/<topic>/publish"
  //   "events": ["run_end", "budget", "advance_gate", "stop_guard", "plan_start", "deadlock", "worker_failure"]
  // }
}
