{
  "name": "ainovel-studio-web",
  "version": "0.1.0",
  "private": true,
  "description": "Bề mặt vận hành của engine ainovel — xuất tĩnh, để `ainovel-cli serve --web` phục vụ trực tiếp.",
  "scripts": {
    "dev": "next dev -p 8421",
    "dev:mock": "NEXT_PUBLIC_MOCK=1 next dev -p 8421",
